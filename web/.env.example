# Backend base URL used by the frontend.
# Local dev: leave blank (defaults to http://localhost:8080).
# Production (Vercel): set to your Render backend URL, e.g. https://idea-validation.onrender.com
VITE_API_URL=

# Supabase (Settings -> API in your Supabase dashboard).
# The anon key is public by design — Row Level Security protects the data.
# NEVER put the service_role key here or anywhere in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
